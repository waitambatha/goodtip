SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://<db_user>:<db_password>@localhost:5432/goodtip

# NRL fixtures/scores via API-SPORTS (v1.rugby.api-sports.io). Get a key at
# dashboard.api-football.com — the same account covers rugby. Without it the
# AFL feed still works and NRL syncs report "unavailable" rather than failing.
# Syncing runs on the server's clock (goodtip-matchsync.timer, installed by
# deploy.sh). This flag turns on a traffic-driven fallback instead, for an
# environment with no systemd timer. Leave False in production.
AUTOSYNC_ENABLED=False

APISPORTS_KEY=
# Optional: pin the NRL's league id to save a lookup request per sync. Find it
# with: manage.py sync_matches --probe-nrl
APISPORTS_NRL_LEAGUE_ID=
# Legacy name for APISPORTS_KEY, still read as a fallback.
THESPORTS_API_KEY=

# Stripe — use TEST keys in dev (sk_test_… / pk_test_…). Billing is dormant if blank.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Postmark — the transactional email provider. Set this and production sends
# via the Postmark API; leave it blank and it falls back to SMTP below.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# DEBUG=True prints email to the console. Set true to deliver for real in dev
# (needs POSTMARK_SERVER_TOKEN, and DEFAULT_FROM_EMAIL must be a sender Postmark
# has verified). Check it with: manage.py check_email you@example.com
EMAIL_SEND_FOR_REAL=True

# Fallback for when real delivery is off: print one-time sign-in codes to the
# runserver terminal. DEBUG only, and never with real delivery on.
SHOW_OTP_IN_CONSOLE=False

# SMTP fallback — only used in production when POSTMARK_SERVER_TOKEN is empty.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GoodTip <no-reply@goodtip.com.au>
GOODTIP_TEAM_EMAIL=team@goodtip.com.au

# Sportradar sports data (see GoodTip_Sports_Data_API_Reference)
SPORTRADAR_API_KEY=
SPORTRADAR_TRIAL_EXPIRES=
