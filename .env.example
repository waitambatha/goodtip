SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://<db_user>:<db_password>@localhost:5432/goodtip

THESPORTS_API_KEY=

# Stripe — use TEST keys in dev (sk_test_… / pk_test_…). Billing is dormant if blank.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Postmark — the transactional email provider. Set this and production sends
# via the Postmark API; leave it blank and it falls back to SMTP below.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# DEBUG=True prints email to the console. Set true to deliver for real in dev.
EMAIL_SEND_FOR_REAL=False

# SMTP fallback — only used in production when POSTMARK_SERVER_TOKEN is empty.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GoodTip <no-reply@goodtip.com.au>
GOODTIP_TEAM_EMAIL=team@goodtip.com.au
