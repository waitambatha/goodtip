[Unit]
Description=GoodTip staging — tick the sports data syncs every 2 minutes

[Timer]
# Same 2-minute cadence as production, deliberately offset. Both instances
# scrape the same pages; firing them together would double the request rate at
# the same instant rather than spreading it across the interval.
OnBootSec=3min
OnUnitActiveSec=2min
RandomizedDelaySec=45
AccuracySec=30
Persistent=true

[Install]
WantedBy=timers.target
