[Unit]
# Continuous deploy for staging: whatever is on origin/staging is what
# staging.goodtip.com.au serves. Same script, same mechanism and same
# trade-offs as goodtip-sync.service -- read that one for why it is pull-based.
# The only differences are the three Environment lines below.
Description=GoodTip Staging Auto-Sync from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mbatha-goodtip
WorkingDirectory=/home/mbatha-goodtip/projects/goodtip-staging
ExecStart=/bin/bash /home/mbatha-goodtip/projects/goodtip-staging/deploy.sh --auto
# The three variables that make one script serve two sites. GOODTIP_DIR is what
# scopes the flock, the blocked-SHA file and the gunicorn reload to this
# instance; without it a staging deploy would operate on production's checkout.
Environment=GOODTIP_DIR=/home/mbatha-goodtip/projects/goodtip-staging
Environment=GOODTIP_BRANCH=staging
Environment=GOODTIP_VENV=/home/mbatha-goodtip/projects/goodtip-staging/venv
# Deliberately stricter than production's `fast`.
#
# The entire point of staging is that it is where a bad commit is allowed to be
# discovered, so there is no reason to wave the suite through here -- and every
# reason to run it, since this is the last gate before the same commit is
# merged to main and deployed to the live site.
#
# `block` since 2026-08-29. It sat at `warn` while the suite was red, and then
# for one last reason after it went green: StagingRobotsTests asserted that
# IS_STAGING was false, which no run on this box can satisfy, so the gate could
# never have passed here. That assertion is now conditional on the environment
# and the suite is green in staging's own env -- a red suite from here is a
# real regression, and stopping the deploy is the right answer to one.
# NOT installed by deploy/install-timers.sh -- that script carries production's
# units and refuses to run from this checkout. Editing this file changes nothing
# until someone with root runs:
#   sudo install -m 644 deploy/systemd/goodtip-staging-sync.service \
#        /etc/systemd/system/goodtip-staging-sync.service && sudo systemctl daemon-reload
Environment=DEPLOY_TEST_GATE=block
# Longer than production's: this one runs the ~6-minute suite. Still shorter
# than the timer's own margin; overlap is prevented by the flock in deploy.sh.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
