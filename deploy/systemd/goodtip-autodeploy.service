[Unit]
# Continuous deploy: whatever is on origin/main is what goodtip.com.au serves.
# Pull-based rather than a GitHub webhook because it needs no inbound port, no
# shared secret and no public endpoint -- the box asks GitHub, GitHub is never
# told about the box. The cost is latency, bounded by the timer interval.
Description=GoodTip — deploy origin/main if it moved
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mbatha-goodtip
WorkingDirectory=/home/mbatha-goodtip/projects/goodtip
ExecStart=/bin/bash /home/mbatha-goodtip/projects/goodtip/deploy.sh --auto
# Longer than the timer interval on purpose: a slow pip install must not be
# killed halfway. Overlap is prevented by the flock in deploy.sh, not here.
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
